PORT=3000
WEB_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_USER=colabora
DB_PASSWORD=colabora
DB_NAME=colabora
NODE_ENV=development
PRODUCTIVITY_MARGIN_PERCENT=20

# Obrigatório: gerar localmente com crypto.randomBytes(48).toString('hex').
# Não usar o texto de exemplo como segredo real; não versionar o valor gerado.
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=168
AUTH_LOGIN_LIMIT=10
AUTH_IP_LIMIT=30
AUTH_REGISTER_LIMIT=10
AUTH_CSRF_LIMIT=60

# Recuperação de senha por e-mail (Brevo API, plano gratuito).
BREVO_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
PASSWORD_RESET_FROM_NAME=Colabora
PUBLIC_APP_URL=http://localhost:5173

# Push: gere com `npx web-push generate-vapid-keys` e não publique a chave privada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@example.com
# Use o mesmo segredo aleatório na API e na Neon Function agendada.
REMINDER_DISPATCH_SECRET=

# Produção: URL fornecida pelo serviço PostgreSQL. Não versionar credenciais reais.
# DATABASE_URL=postgresql://usuario:senha@host:5432/colabora
# DB_SSL=true
# DB_POOL_SIZE=5
# UPLOADS_DIRECTORY=/app/uploads/agenda
